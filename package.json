{
  "name": "kattam-matrimony",
  "version": "1.0.0",
  "description": "Offline-first matrimonial candidate management system with Vedic astrology support",
  "license": "MIT",
  "author": {
    "name": "Vignesh-72",
    "url": "https://github.com/Vignesh-72"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Vignesh-72/Kattam.git"
  },
  "homepage": "https://github.com/Vignesh-72/Kattam#readme",
  "bugs": {
    "url": "https://github.com/Vignesh-72/Kattam/issues"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:dev": "cross-env BROWSER=none npm run dev & npm run electron:wait",
    "electron:wait": "wait-on http://localhost:5173 && electron .",
    "electron:build": "npm run build && electron-builder",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/noto-sans-tamil": "^5.3.0",
    "@fontsource/noto-serif-tamil": "^5.3.0",
    "astronomy-engine": "^2.1.19",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.28.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2",
    "sqlite3": "^6.0.1"
  },
  "build": {
    "appId": "com.kattam.matrimony",
    "productName": "Kattam Matrimony",
    "asar": true,
    "asarUnpack": [
      "**/node_modules/sqlite3/**/*"
    ],
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "maintainer": "Vignesh-72 <vignesh@kattam.app>",
      "category": "Office"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "signingHashAlgorithms": [],
      "sign": null
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.utilities"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/sqlite3": "^5.1.0",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/ui": "^1.6.0",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^28.3.3",
    "electron-builder": "^25.1.8",
    "electron-rebuild": "^3.2.9",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.11.0",
    "jsdom": "^30.0.1",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.11.0",
    "vite": "^5.4.10",
    "vitest": "^1.6.0",
    "wait-on": "^9.1.0"
  },
  "overrides": {
    "@noble/hashes": "1.3.2"
  }
}
